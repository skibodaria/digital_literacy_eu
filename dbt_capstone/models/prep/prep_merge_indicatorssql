-- models/prep/prep_merge_indicators.sql
-- {{ config(materialized='table') }}


SELECT
    LOWER(answer_id) as indicator_code,
    CASE
        WHEN answer_id IN ('QE7_1_1', 'QE7_1_2') THEN 'combined' || question_english || '_'|| answer_text|| '_yes to some extent'
        WHEN answer_id IN ('QE7_4_1','QE7_4_2') THEN 'combined' || question_english || '_'|| answer_text|| '_yes to some extent'
        WHEN answer_id IN ('QE6R_2_1', 'QE6R_2_2') THEN 'combined' || question_english || '_'|| answer_text||'_tend to agree'
        ELSE question_english || '_'|| answer_text
    END AS indicator_name,
    'sb_104_' || LOWER(sheet) as table_code,
    'Eurobatometer Standard' as source_system
FROM {{ source('eurobars', 'eurobarometer_104_map')}} 
WHERE answer_id IN ('QA6_1_1', 'QA6_5_1', 'QA6_7_1', 'QA6_8_1', 'QA6_9_1', 'QA8_1_1', 'QE3_1_1', 
    'QE3_5_1', 'QE7_1_1', 'QE7_4_1', 'QE6R_2_1')

UNION ALL 

SELECT
    LOWER(answer_id) as indicator_code,
    CASE
        WHEN answer_id IN ('QE1_5_1', 'QE1_5_2') THEN 'combined' || question_english ||'_'|| answer_text || '_fairly important'
        WHEN answer_id IN ('QE1_10_1', 'QE1_10_2') THEN 'combined' || question_english || '_'|| answer_text || '_fairly_important'
        WHEN answer_id IN ('QE1_1_1', 'QE1_1_2') THEN 'combined' || question_english || '_'|| answer_text || 'fairly_important'
        ELSE question_english || '_' || answer_text
    END AS indicator_name,
    'sp566_' || LOWER(sheet) as table_code, 
    'Eurobarometer Special' as source_system
FROM {{ source('eurobars', 'eurobarometer_sp566_map')}}
WHERE answer_id IN ('QE9_9_1', 'QE1_5_1', 'QE1_10_1', 'QE1_1_1')

UNION ALL

SELECT
    LOWER(indicator_code) AS indicator_code,
    indicator_name,
    table_code,
    'Eurostat' as source_system
FROM {{ ref('prep_eurostat_map' )}}
WHERE indicator_code IN (
    -- skills:
    'I_DSK2_AB','I_DSK2_B', 'I_DSK2_LW', 'I_DSK2_N', 'I_DSK2_LM', 'I_DSK2_X',
    -- usage:
    'I_IDAY', 'I_IUAI', 'I_IEID','I_MAPS', 'I_IUCPP', 'I_IUPDG','I_IUPS','I_IUCHAT1'
    -- gov:
    'I_IGOVAPR','I_IGOVTAX2','I_IUGOV1','I_IGOVBE','I_IGOVRCC', 'I_IGOVRX', 
    -- media
    'I_IUPOL2','I_TIC','I_UDI', 
    -- non using eID 
    'I_IREIDNO','I_IREIDNA', 'I_IREIDSEC','I_IREIDTEC', 'I_IREIDNN', 'I_IREIDDEV', 'I_IREIDOTH',
    -- e-gov legacy data
    'I_IGOV12FM', 'I_IGOV12IF', 'I_IIGOVX', 
    -- no internet usage
    'I_IUID1X', 'I_IUX', 
)